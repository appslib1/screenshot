<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/annotateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaryColor"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="@color/white" />

    <com.screenshot_capture.screenshot_photo.AnnotateOverlayView
        android:id="@+id/annotateView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Color swatches : visibles pour les outils colorés (texte, flèche). -->
    <LinearLayout
        android:id="@+id/colorBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/darkColor"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/colorRed"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="6dp" />

        <View
            android:id="@+id/colorYellow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="6dp" />

        <View
            android:id="@+id/colorBlue"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="6dp" />

        <View
            android:id="@+id/colorWhite"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="6dp" />

        <View
            android:id="@+id/colorBlack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/annotateBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/tool_button_bg"
            android:contentDescription="@string/annotText"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:src="@drawable/baseline_text_fields_24"
            app:tint="@color/darkColor" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolArrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/tool_button_bg"
            android:contentDescription="@string/annotArrow"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:src="@drawable/baseline_arrow_forward_24"
            app:tint="@color/darkColor" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolBlur"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/tool_button_bg"
            android:contentDescription="@string/annotBlur"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:src="@drawable/baseline_blur_on_24"
            app:tint="@color/darkColor" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grayColor" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/undoBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/annotUndo"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:src="@drawable/baseline_undo_24"
            app:tint="@color/darkColor" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grayColor" />

        <Button
            android:id="@+id/saveBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="@string/save"
            android:textColor="@color/primaryColor"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ad_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:minHeight="50dp" />
</LinearLayout>
