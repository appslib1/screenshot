<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/annotateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaryColor"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="@color/white" />

    <com.screenshot_capture.screenshot_photo.AnnotateOverlayView
        android:id="@+id/annotateView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Options contextuelles : color swatches pour texte/flèche, slider d'intensité pour blur.
         Les deux occupent le même slot ; l'activity bascule la visibilité selon l'outil sélectionné. -->
    <FrameLayout
        android:id="@+id/toolOptionsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/darkColor">

        <LinearLayout
            android:id="@+id/colorBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/colorRed"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="6dp" />

            <View
                android:id="@+id/colorYellow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="6dp" />

            <View
                android:id="@+id/colorBlue"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="6dp" />

            <View
                android:id="@+id/colorWhite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="6dp" />

            <View
                android:id="@+id/colorBlack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blurBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blurLevelLabel"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/blurSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:max="3"
                android:progress="1" />

            <TextView
                android:id="@+id/blurLevelName"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/blurMed"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/annotateBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/tool_button_bg"
            android:contentDescription="@string/annotText"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:src="@drawable/baseline_text_fields_24"
            app:tint="@color/darkColor" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolArrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/tool_button_bg"
            android:contentDescription="@string/annotArrow"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:src="@drawable/baseline_arrow_forward_24"
            app:tint="@color/darkColor" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolBlur"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/tool_button_bg"
            android:contentDescription="@string/annotBlur"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:src="@drawable/baseline_blur_on_24"
            app:tint="@color/darkColor" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grayColor" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/undoBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/annotUndo"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:src="@drawable/baseline_undo_24"
            app:tint="@color/darkColor" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grayColor" />

        <Button
            android:id="@+id/saveBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="@string/save"
            android:textColor="@color/primaryColor"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ad_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:minHeight="50dp" />
</LinearLayout>
